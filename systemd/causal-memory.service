[Unit]
Description=causal-memory MCP HTTP server
After=network.target

[Service]
Type=simple
Environment=CAUSAL_MEMORY_DB=/opt/causal-memory/data/causal.db
Environment=CAUSAL_MEMORY_HTTP_AUTH_TOKEN=cm_internal_f6a9c2e14b7d48f0a3c5e9d21b876543
ExecStart=/opt/causal-memory/causal-memory http --host 127.0.0.1 --port 9938
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
