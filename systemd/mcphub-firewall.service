[Unit]
Description=Block public access to MCPHub :3100 / quota-platform :3200,:3300 (host network mode binds 0.0.0.0; only nginx may proxy them)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for p in 3100 3200 3300; do /usr/sbin/iptables -C INPUT -p tcp --dport $p ! -s 127.0.0.1 -j DROP 2>/dev/null || /usr/sbin/iptables -A INPUT -p tcp --dport $p ! -s 127.0.0.1 -j DROP; done'
ExecStop=/bin/sh -c 'for p in 3100 3200 3300; do /usr/sbin/iptables -D INPUT -p tcp --dport $p ! -s 127.0.0.1 -j DROP 2>/dev/null; done'

[Install]
WantedBy=multi-user.target
